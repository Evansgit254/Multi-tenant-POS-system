# ─── ServePoint POS — Server Environment Variables ───────────────────────────
# Copy this file to .env and fill in your values

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | production | test
PORT=3000
APP_URL=http://localhost:5173  # Frontend URL (used in password reset links and QR codes)

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173  # Required in production — set to your domain

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default — no additional config needed for dev)

# ── Email (SMTP) ─── NEW: upgraded from Ethereal to real SMTP ─────────────────
# Leave blank to use Ethereal test mode (dev)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="ServePoint <noreply@servepoint.app>"

# ── SMS — Africa's Talking ─── NEW ───────────────────────────────────────────
# Leave blank to log SMS to console (dev mode)
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=sandbox
AT_SENDER_ID=SERVEPOINT
