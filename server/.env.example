# ─── ServePoint POS — Server Environment Variables ───────────────────────────
# Copy this file to .env and fill in your values.
# CRITICAL: Never commit your actual .env file to version control.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | production | test
PORT=3000
APP_URL=http://localhost:5173  # Frontend URL (used in password reset links and QR codes)

# ── Auth ──────────────────────────────────────────────────────────────────────
# SECURITY: Use `openssl rand -hex 32` to generate a strong secret
JWT_SECRET=replace-with-a-64-char-random-hex-string
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173  # Required in production — set to your domain

# M-4: Set to 'false' to disable public self-registration in production.
# When false, only super_admin can provision new tenants via the SuperAdmin dashboard.
REGISTRATION_ENABLED=true

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default — no additional config needed for dev)
DATABASE_URL="file:./dev.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://user:password@host:5432/servepoint"

# ── Secrets Encryption ────────────────────────────────────────────────────────
# H-10: Required for encrypting M-Pesa credentials at rest.
# Generate with: openssl rand -hex 32
# CRITICAL: If you lose this key, all stored M-Pesa credentials become unreadable.
ENCRYPTION_KEY=replace-with-a-64-char-random-hex-string

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Leave blank to use Ethereal test mode (dev only)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="ServePoint <noreply@servepoint.app>"

# ── SMS — Africa's Talking ────────────────────────────────────────────────────
# Leave blank to log SMS to console (dev mode)
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=sandbox
AT_SENDER_ID=SERVEPOINT

# ── M-Pesa Integration ────────────────────────────────────────────────────────
MPESA_ENV=sandbox             # sandbox | production
SERVER_URL=http://localhost:3000

# H-7: A shared secret appended to the callback URL to validate Safaricom webhook calls.
# Generate with: openssl rand -hex 16
MPESA_WEBHOOK_SECRET=replace-with-a-random-secret
